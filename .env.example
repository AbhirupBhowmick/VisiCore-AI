# VisiCore AI — Environment Variables Configuration

# ─── Database Configuration (PostgreSQL) ─────────────────────────────────────
DATABASE_URL=postgresql://admin:password@localhost:5432/aivideodb
DB_HOST=localhost
DB_PORT=5432
DB_USER=admin
DB_PASSWORD=password
DB_NAME=aivideodb

# ─── JWT Authentication Secret ───────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_key_make_sure_it_is_long_and_secure

# ─── Object Storage (MinIO S3) ───────────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_URL=http://localhost:9000
NEXT_PUBLIC_MINIO_URL=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=aivideo
MINIO_SECURE=false

# ─── Message Queue (RabbitMQ) ────────────────────────────────────────────────
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# ─── Google Gemini AI Key (Required for Python Worker) ──────────────────────
GEMINI_API_KEY=your_google_gemini_api_key_here

# ─── Web Application Base URL ────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=
